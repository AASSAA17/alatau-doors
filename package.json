    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "motion": "14.7.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
