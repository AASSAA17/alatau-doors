    "cloud:migrate": "node scripts/cloud.mjs migrate",
    "cloud:seed": "node scripts/cloud.mjs seed",
    "cloud:accounts": "node scripts/cloud.mjs accounts",
    "cloud:mfa-enrollment": "node scripts/cloud.mjs mfa-enrollment",
