# Copy to .env.cloud.local on the operator's machine. Never commit populated env files.
# Vercel runtime variables:
APP_MODE=public-demo
DATABASE_PROVIDER=postgres
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Optional Google sign-in. Add both as server-side Vercel variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional passwordless email (both code and link); configure a verified sender domain.
AUTH_MAIL_PROVIDER=
RESEND_API_KEY=
AUTH_MAIL_FROM=
# Optional SMS. Enable only after a separate spending approval and provider limits.
AUTH_SMS_PROVIDER=
AUTH_SMS_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Operator-only variables. NEVER add these to Vercel:
DATABASE_URL_UNPOOLED=
DEMO_CREDENTIALS_PATH=
DEMO_SEED_CONFIRM=fictional-data-only
# Do not set ALATAU_DB_TASK or any NEXT_PUBLIC_* secret in Vercel.

# Explicit security rollout after verified mail and staff enrollment preparation.
AUTH_SECURITY=
