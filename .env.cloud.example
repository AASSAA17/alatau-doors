# Copy to .env.cloud.local on the operator's machine. Never commit populated env files.
# Vercel runtime variables:
APP_MODE=public-demo
DATABASE_PROVIDER=postgres
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Operator-only variables. NEVER add these to Vercel:
DATABASE_URL_UNPOOLED=
DEMO_CREDENTIALS_PATH=
DEMO_SEED_CONFIRM=fictional-data-only
# Do not set ALATAU_DB_TASK or any NEXT_PUBLIC_* secret in Vercel.
